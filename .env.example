# ============================================================
#  MedicalQA 环境变量配置模板
# ============================================================
#  使用方法：
#    1. 复制本文件为 .env：  cp .env.example .env
#    2. 修改 .env 中的值（API Key 建议配在系统环境变量中，.env 中可留空）
#    3. .env 已在 .gitignore 中，不会被提交到 Git
#
#  优先级：LLM_* > 厂商专属变量（DASHSCOPE_API_KEY 等）> 本文件中的默认值
# ============================================================


# ------------------------------------------------------------
#  Neo4j 知识图谱数据库
# ------------------------------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medicalqa123
NEO4J_DBNAME=neo4j

# Docker Compose 对外暴露端口（本地已有服务冲突时可修改）
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687


# ------------------------------------------------------------
#  LLM 提供商选择
# ------------------------------------------------------------
#  可选值：dashscope / mimo / deepseek / ollama
#  切换提供商后，下方对应的厂商变量自动生效
LLM_PROVIDER=dashscope


# ------------------------------------------------------------
#  阿里百炼（DashScope）— LLM_PROVIDER=dashscope
# ------------------------------------------------------------
# DASHSCOPE_API_KEY=              # 优先读系统环境变量，此处留空即可
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-flash
DASHSCOPE_MODELS=deepseek-v4-flash,qwen3.6-flash,qwen3.7-plus,qwen3.7-max,deepseek-v4-pro,kimi-k2.6


# ------------------------------------------------------------
#  小米 MiMo — LLM_PROVIDER=mimo
# ------------------------------------------------------------
# MIMO_API_KEY=                   # 优先读系统环境变量，此处留空即可
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MODELS=mimo-v2.5-pro,mimo-v2.5


# ------------------------------------------------------------
#  DeepSeek — LLM_PROVIDER=deepseek
# ------------------------------------------------------------
# DEEPSEEK_API_KEY=               # 优先读系统环境变量，此处留空即可
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro


# ------------------------------------------------------------
#  Ollama 本地部署 — LLM_PROVIDER=ollama
# ------------------------------------------------------------
#  无需 API Key，需要先安装 Ollama 并拉取模型：
#    ollama pull qwen:32b
#    ollama pull llama2-chinese:13b-chat-q8_0
OLLAMA_QWEN_MODEL=qwen:32b
OLLAMA_LLAMA_MODEL=llama2-chinese:13b-chat-q8_0
# Docker 后端容器访问宿主机 Ollama 时使用；Linux Docker 也已在 compose 中配置 host-gateway
OLLAMA_HOST=http://host.docker.internal:11434


# ------------------------------------------------------------
#  通用 LLM 覆盖（可选，优先级最高）
# ------------------------------------------------------------
#  如果设置了以下变量，会覆盖上方厂商专属变量
#  适合在同一提供商内临时切换模型，或使用自定义 API 端点
# LLM_API_KEY=                    # 优先读系统环境变量，此处留空即可
# LLM_BASE_URL=https://your-api-endpoint/v1
# LLM_MODEL=your-model-name
# LLM_MODELS=model-a,model-b,model-c


# ------------------------------------------------------------
#  PostgreSQL 数据库
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5431/medicalqa

# Docker Compose PostgreSQL 服务变量
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medicalqa
POSTGRES_PORT=5431


# ------------------------------------------------------------
#  FastAPI / 认证
# ------------------------------------------------------------
SESSION_SECRET=dev-insecure-change-me
SESSION_COOKIE_NAME=session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=False
CORS_ORIGINS=http://localhost:5173


# ------------------------------------------------------------
#  本地模型与数据路径
# ------------------------------------------------------------
NER_MODEL_NAME=model/chinese-roberta-wwm-ext
NER_CHECKPOINT=best_roberta_rnn_model_ent_aug
DATA_DIR=data
TMP_DIR=tmp_data
MODEL_DIR=model


# ------------------------------------------------------------
#  多轮诊断
# ------------------------------------------------------------
MAX_CLARIFICATION_TURNS=2
CLARIFICATION_ENABLED=True


# ------------------------------------------------------------
#  日志
# ------------------------------------------------------------
LOG_LEVEL=INFO
